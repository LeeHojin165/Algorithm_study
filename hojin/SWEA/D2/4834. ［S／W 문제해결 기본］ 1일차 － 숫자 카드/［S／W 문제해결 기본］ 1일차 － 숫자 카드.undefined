from collections import Counter

T = int(input())
# 여러개의 테스트 케이스가 주어지므로, 각각을 처리합니다.
for test_case in range(1, T + 1):
    N = int(input())
    input_str = input()
 
    num_cards = Counter(input_str)

    result_sort = sorted(num_cards.items(), key= lambda x : (x[1], x[0]), reverse=True)
    print(f"#{test_case} {result_sort[0][0]} {result_sort[0][1]}")
