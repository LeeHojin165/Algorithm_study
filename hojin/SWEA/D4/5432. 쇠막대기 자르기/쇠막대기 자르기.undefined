T = int(input())
for test_case in range(1, T + 1):
    input_str = input()

    total_sum = 0
    piece_stack = []

    for c in input_str:
        if c == '(':
            piece_stack.append(c)
        elif c == ')':
            if piece_stack[-1] == '(':
                piece_stack.pop()
                piece_stack.append(1)
            else:
                temp_raser = 0

                while piece_stack[-1] != '(':
                    temp_raser += piece_stack.pop()

                piece_stack.pop()
                total_sum += (temp_raser + 1)
                piece_stack.append(temp_raser)


    print(f"#{test_case} {total_sum}")