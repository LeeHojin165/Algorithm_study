for test_case in range(1, 11):
    N = int(input())
    input_str = input()
    
    calculate_stack = []
    calculate_stack.append(int(input_str[0]))
    i = 1

    while i < N:
        if input_str[i] == '+':
            a = calculate_stack.pop()
            b = int(input_str[i + 1])
            calculate_stack.append(a + b)
            i += 2
    
    print(f"#{test_case} {calculate_stack.pop()}")

