
for i in range(10):
    test_case = int(input())

    ladder_map = [list(map(int, input().split())) for _ in range(100)]

    cur_x, cur_y = (99, 0)
    for j in range(100):
        if ladder_map[99][j] == 2:
            cur_y = j

    while cur_x > 0:

        if cur_y > 0 and ladder_map[cur_x][cur_y - 1] == 1: # 왼쪽에 길이 있다면
            while cur_y > 0 and ladder_map[cur_x][cur_y - 1] == 1:
                cur_y -= 1
        elif cur_y < 99 and ladder_map[cur_x][cur_y + 1] == 1: # 오른쪽에 길이 있다면
            while cur_y < 99 and ladder_map[cur_x][cur_y + 1] == 1:
                cur_y += 1

        cur_x -= 1 # 그렇지 않다면 위로 이동 

    print(f"#{test_case} {cur_y}")